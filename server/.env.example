# =====================================================================
# KumbhMitra Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# =====================================================================

# ── Server ─────────────────────────────────────────────────────────────
# Render / hosting platforms set PORT automatically. Leave unset locally to use 5000.
PORT=5000
# development | production | test
NODE_ENV=development

# ── Database (required) ─────────────────────────────────────────────────
# Supabase connection string (preferred). Get it from Supabase → Project Settings → Database.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Alternative (only if not using DATABASE_URL):
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_NAME=postgres

# ── Auth (required for protected routes) ───────────────────────────────
# Supabase JWT secret (API settings). Server-side only — NEVER ship to the client.
SUPABASE_JWT_SECRET=
# Supabase project URL, e.g. https://xyz.sumbase.co
SUPABASE_URL=
# Supabase anon key (public by design; safe for client bundles)
SUPABASE_ANON_KEY=

# ── CORS (required) ─────────────────────────────────────────────────────
# Comma-separated allowed origins. Do NOT use * in production.
# On Render, set this to your frontend URL, e.g. https://kumbhmitra.onrender.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Connection pool (optional) ──────────────────────────────────────────
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
